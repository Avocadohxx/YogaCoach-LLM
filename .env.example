LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=DeepSeek-V4.1-Flash-1017
DATABASE_PATH=./data/yoga.db
# Optional chat-completions-compatible provider. Confirmed rule evidence may be
# sent as a compact numeric summary for structured coaching; no image/keypoints.
# Primary 133-point RTMW local model, relative to repository root (absolute path supported).
POSE133_MODEL_PATH=./data/models/rtmw_x_384.onnx
# Optional independently reviewed rules; default mountain uses existing reviewed B config.
# POSE133_TADASANA_RULES_PATH=/absolute/path/to/reviewed_mountain_rules.json
# POSE133_ARDHAKATI_RULES_PATH=/absolute/path/to/reviewed_sidebend_rules.json
