{
  "name": "yogacoach-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "mock": "node scripts/mock-backend.mjs",
    "check:integration": "node scripts/check-integration.mjs",
    "format": "prettier --write src vite.config.ts",
    "format:check": "prettier --check src vite.config.ts"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.7.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
